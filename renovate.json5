{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  gitIgnoredAuthors: [
    'github-actions[bot]@users.noreply.github.com',
  ],
  packageRules: [
    {
      description: 'Triton Server PyTorch variant - only update YY.MM version, keep -pyt-python-py3 suffix',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'nvcr.io/nvidia/tritonserver',
      ],
      versioning: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)-pyt-python-py3$',
    },
    {
      description: 'TensorRT-LLM uses semantic versioning',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'nvcr.io/nvidia/tensorrt-llm/release',
      ],
      versioning: 'semver',
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      description: 'Update appVersion in Chart.yaml from renovate comment hint',
      managerFilePatterns: [
        '//charts/.+/Chart\\.yaml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nappVersion:\\s*"(?<currentValue>[^"]+)"',
      ],
    },
    {
      customType: 'regex',
      description: 'Helm charts from HTTP repositories in the Helmfile environments (charts.*)',
      managerFilePatterns: [
        '/^helmfile/environments/.+\\.yaml\\.gotmpl$/',
      ],
      matchStrings: [
        'repository: "(?<registryUrl>https?://[^"]+)"\\n\\s*name: "(?<depName>[^"]+)"\\n\\s*version: "(?<currentValue>[^"]+)"',
      ],
      datasourceTemplate: 'helm',
    },
    {
      customType: 'regex',
      description: 'Helm charts from OCI registries in the Helmfile environments (charts.*)',
      managerFilePatterns: [
        '/^helmfile/environments/.+\\.yaml\\.gotmpl$/',
      ],
      matchStrings: [
        'repository: "(?<packageName>[a-z0-9.-]+\\.[a-z]+/[^"]+)"\\n\\s*name: "(?<depName>[^"]+)"\\n\\s*version: "(?<currentValue>[^"]+)"',
      ],
      datasourceTemplate: 'docker',
      packageNameTemplate: '{{{packageName}}}/{{{depName}}}',
    },
    {
      customType: 'regex',
      description: 'Images in the Helmfile environments (images.*)',
      managerFilePatterns: [
        '/^helmfile/environments/.+\\.yaml\\.gotmpl$/',
      ],
      matchStrings: [
        'registry: "(?<packageName>[^"]+)"\\n\\s*repository: "(?<depName>[^"]+)"\\n\\s*tag: "(?<currentValue>[^"]+)"',
      ],
      datasourceTemplate: 'docker',
      packageNameTemplate: '{{{packageName}}}/{{{depName}}}',
    },
  ],
  'helm-values': {
    managerFilePatterns: [
      '/charts/.+/values\\.yaml$/',
    ],
  },
}
