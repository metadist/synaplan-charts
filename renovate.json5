{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  gitIgnoredAuthors: [
    'github-actions[bot]@users.noreply.github.com',
  ],
  packageRules: [
    {
      description: 'Triton Server PyTorch variant - only update YY.MM version, keep -pyt-python-py3 suffix',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'nvcr.io/nvidia/tritonserver',
      ],
      versioning: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)-pyt-python-py3$',
    },
    {
      description: 'TensorRT-LLM uses semantic versioning',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'nvcr.io/nvidia/tensorrt-llm/release',
      ],
      versioning: 'semver',
    },
    {
      description: 'Group all MariaDB operator charts',
      matchDatasources: [
        'helm',
      ],
      groupName: 'mariadb',
      matchPackageNames: [
        'mariadb-operator-crds',
        'mariadb-operator',
        'mariadb-cluster',
      ],
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      description: 'Update appVersion in Chart.yaml from renovate comment hint',
      fileMatch: ['/charts/.+/Chart\\.yaml$'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nappVersion:\\s*"(?<currentValue>[^"]+)"',
      ],
    },
  ],
  'helm-values': {
    managerFilePatterns: [
      '/charts/.+/values\\.yaml$/',
      '/deployments/.+/values-.+\\.yaml$/',
    ],
  },
}
