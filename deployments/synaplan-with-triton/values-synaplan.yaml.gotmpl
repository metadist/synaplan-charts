{{- $synaplanUrl := .Values.services.synaplan.url | required "services.synaplan.url is required" }}
{{- $synaplanHost := $synaplanUrl | trimPrefix "https://" | trimPrefix "http://" }}
{{- $ns := .Values | getOrNil "namespace" | default "synaplan" }}
{{- $oidc := index .Values.services.synaplan "oidc" | default dict }}
{{- $oidcEnabled := true }}
{{- if hasKey $oidc "enabled" }}
{{- $oidcEnabled = index $oidc "enabled" }}
{{- end }}
{{- $tritonMode := .Values.services.triton.mode | default "gpu" }}
{{- $tritonLocal := or (eq $tritonMode "gpu") (eq $tritonMode "cpu") }}
{{- $ollamaBaseUrl := index (index .Values.services.synaplan "ollama" | default dict) "baseUrl" | default "" }}

{{- with .Values | getOrNil "image" }}
image:
  {{- range $k, $v := . }}
  {{ $k }}: {{ $v | quote }}
  {{- end }}
{{- end }}

{{- if .Values.cluster.customRootCA }}
# CA from the cert-manager-issued ingress certificate secret (see ingress.tls).
customRootCA:
  secretRef: "synaplan-tls"
{{- end }}

publicUrl: {{ $synaplanUrl | quote }}

tritonMode: {{ $tritonMode | quote }}

database:
  host: "mariadb-cluster.{{ $ns }}.svc.cluster.local"
  # Secret created alongside the mariadb-cluster (see resources.yaml).
  passwordSecretRef: "mariadb-credentials"

triton:
  {{- if $tritonLocal }}
  url: "triton.{{ $ns }}.svc.cluster.local:8001"
  {{- else }}
  url: ""
  {{- end }}

{{- if $ollamaBaseUrl }}
ollama:
  baseUrl: {{ $ollamaBaseUrl | quote }}
{{- end }}

tika:
  enabled: true
  url: {{ index (index .Values.services "tika" | default dict) "url" | default (printf "http://tika.%s.svc.cluster.local:9998" $ns) | quote }}

{{- with index (index .Values.services.synaplan "models" | default dict) "enabled" }}
models:
  enabled:
    {{- range . }}
    - {{ . | quote }}
    {{- end }}
  {{- with index (index $.Values.services.synaplan "models") "defaults" }}
  defaults:
    {{- range $cap, $model := . }}
    {{ $cap }}: {{ $model | quote }}
    {{- end }}
  {{- end }}
{{- end }}

oidc:
  enabled: {{ $oidcEnabled }}
  {{- if $oidcEnabled }}
  {{- with index $oidc "issuerURI" }}
  issuerURI: {{ . | quote }}
  {{- end }}
  {{- with index $oidc "clientId" }}
  clientId: {{ . | quote }}
  {{- end }}
  {{- with index $oidc "clientSecretRef" }}
  clientSecretRef: {{ . | quote }}
  {{- else }}
  {{- with index $oidc "clientSecret" }}
  clientSecret: {{ . | quote }}
  {{- end }}
  {{- end }}
  {{- end }}

{{- with .Values.services | getOrNil "tts" }}
tts:
  {{- toYaml . | nindent 2 }}
{{- end }}

{{- with .Values.services.synaplan | getOrNil "apiKeysSecretRef" }}
apiKeysSecretRef: {{ . | quote }}
{{- end }}

{{- with .Values.services.synaplan | getOrNil "env" }}
env:
  {{- toYaml . | nindent 2 }}
{{- end }}

{{- with .Values | getOrNil "persistence" }}
persistence:
  {{- with index . "uploads" }}
  uploads:
    enabled: true
    {{- with index . "accessMode" }}
    accessMode: {{ . | quote }}
    {{- end }}
    {{- with index . "size" }}
    size: {{ . | quote }}
    {{- end }}
  {{- end }}
{{- end }}

ingress:
  enabled: true
  className: {{ .Values.cluster.ingressClassName | quote }}
  annotations:
    {{- with index .Values.cluster "certIssuer" }}
    cert-manager.io/cluster-issuer: {{ . | quote }}
    {{- end }}
    nginx.ingress.kubernetes.io/proxy-buffer-size: "16k"
    nginx.ingress.kubernetes.io/proxy-buffers-number: "4"
    nginx.ingress.kubernetes.io/proxy-busy-buffers-size: "16k"
    {{- with index (index .Values.services.synaplan "ingress" | default dict) "annotations" }}
    {{- toYaml . | nindent 4 }}
    {{- end }}
  hosts:
    - host: {{ $synaplanHost | quote }}
      paths:
        - path: /
          pathType: ImplementationSpecific
  tls:
    - secretName: synaplan-tls
      hosts:
        - {{ $synaplanHost | quote }}
