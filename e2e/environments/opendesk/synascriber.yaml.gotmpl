# Meeting notes (synaScriber) with Synaplan inside openDesk, for the e2e run
# with E2E_OPENDESK_SYNASCRIBER=true: speech-to-text on CPU, the plugin,
# transcriber and Secrets through the synaplan release, and Jitsi's part
# through helmfile/opendesk/synascriber-jitsi.yaml.gotmpl.
apps:
  synaplanStt:
    enabled: true
technical:
  synaplan:
    synascriber:
      enabled: true
customization:
  release:
    jitsi:
      synascriber: '{{ env "E2E_ROOT" }}/helmfile/opendesk/synascriber-jitsi.yaml.gotmpl'
