{{- $pull := list }}
{{- range .Values.technical.synaplan.models.enabled }}
{{- if hasPrefix "ollama:" . }}
{{- $pull = append $pull (trimPrefix "ollama:" .) }}
{{- end }}
{{- end }}
ollama:
  gpu:
    enabled: {{ eq .Values.technical.ollama.mode "gpu" }}
  # The models Synaplan enables
  models:
    pull:
      {{- toYaml $pull | nindent 6 }}

persistentVolume:
  enabled: true
  size: {{ .Values.persistence.storages.ollama.size | quote }}
  storageClass: {{ coalesce .Values.persistence.storages.ollama.storageClassName .Values.persistence.storageClassNames.RWO | default "" | quote }}

{{- with .Values.images.ollama }}
{{- if or .repository .tag }}
image:
  {{- with .repository }}
  repository: {{ printf "%s/%s" (coalesce $.Values.global.imageRegistry $.Values.images.ollama.registry) . | trimPrefix "/" | quote }}
  {{- end }}
  {{- with .tag }}
  tag: {{ . | quote }}
  {{- end }}
{{- end }}
{{- end }}
