mariadb:
  # Generated by the operator when the Secret does not exist yet
  rootPasswordSecretKeyRef:
    name: "mariadb-credentials"
    key: "root-password"
    generate: true
  # Single instance, no Galera.
  image: "mariadb:12.3"
  storage:
    size: {{ .Values.persistence.storages.synaplanMariadb.size | quote }}
    storageClassName: {{ coalesce .Values.persistence.storages.synaplanMariadb.storageClassName .Values.persistence.storageClassNames.RWO | default "" | quote }}
  replicas: 1
  galera:
    enabled: false
  resources:
    requests:
      cpu: 100m
      memory: 128Mi
    limits:
      cpu: 500m
      memory: 1Gi

databases:
  - name: {{ .Values.databases.synaplan.name | quote }}
    characterSet: utf8
    collate: utf8_general_ci
    cleanupPolicy: Delete
    requeueInterval: 10h
    retryInterval: 30s

# The password is the one in Synaplan's credentials Secret.
users:
  - name: {{ .Values.databases.synaplan.username | quote }}
    passwordSecretKeyRef:
      name: "synaplan-credentials"
      key: "password"
    host: "%"
    cleanupPolicy: Delete
    requeueInterval: 10h
    retryInterval: 30s

grants:
  - name: {{ .Values.databases.synaplan.username | quote }}
    privileges:
      - "ALL PRIVILEGES"
    database: "*"
    table: "*"
    username: {{ .Values.databases.synaplan.username | quote }}
    grantOption: true
    host: "%"
    cleanupPolicy: Delete
    requeueInterval: 10h
    retryInterval: 30s
