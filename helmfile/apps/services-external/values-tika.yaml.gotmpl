{{- with .Values.images.tika }}
{{- if or .repository .tag }}
image:
  {{- with .repository }}
  repository: {{ printf "%s/%s" (coalesce $.Values.global.imageRegistry $.Values.images.tika.registry) . | trimPrefix "/" | quote }}
  {{- end }}
  {{- with .tag }}
  tag: {{ . | quote }}
  {{- end }}
{{- end }}
{{- end }}
