environments:
  {{ .Environment.Name }}: {}

---

repositories:
  - name: "mariadb-repo"
    url: {{ .Values.charts.mariadb.repository | quote }}
    oci: true
  - name: "tika-repo"
    url: {{ .Values.charts.tika.repository | quote }}
  - name: "ollama-repo"
    url: {{ .Values.charts.ollama.repository | quote }}

releases:
  - name: "synaplan-mariadb"
    chart: "mariadb-repo/{{ .Values.charts.mariadb.name }}"
    version: {{ .Values.charts.mariadb.version | quote }}
    installed: {{ .Values.apps.synaplanMariadb.enabled }}
    values:
      - "values-synaplan-mariadb.yaml.gotmpl"
      {{- range .Values.customization.release.synaplanMariadb }}
      - {{ . }}
      {{- end }}

  - name: "tika"
    chart: "tika-repo/{{ .Values.charts.tika.name }}"
    version: {{ .Values.charts.tika.version | quote }}
    installed: {{ .Values.apps.tika.enabled }}
    values:
      - "values-tika.yaml.gotmpl"
      {{- range .Values.customization.release.tika }}
      - {{ . }}
      {{- end }}

  - name: "triton"
    chart: "../../../charts/triton"
    installed: {{ .Values.apps.triton.enabled }}
    values:
      - "values-triton-{{ .Values.technical.triton.mode }}.yaml"
      {{- range .Values.customization.release.triton }}
      - {{ . }}
      {{- end }}

  - name: "ollama"
    chart: "ollama-repo/{{ .Values.charts.ollama.name }}"
    version: {{ .Values.charts.ollama.version | quote }}
    installed: {{ .Values.apps.ollama.enabled }}
    values:
      - "values-ollama.yaml.gotmpl"
      {{- range .Values.customization.release.ollama }}
      - {{ . }}
      {{- end }}
