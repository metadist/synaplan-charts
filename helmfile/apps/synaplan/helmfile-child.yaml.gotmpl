environments:
  {{ .Environment.Name }}: {}

---

releases:
  - name: "synaplan"
    chart: "../../../charts/synaplan"
    installed: {{ .Values.apps.synaplan.enabled }}
    {{- if .Values.apps.stt.enabled }}
    needs:
      - "stt"
    {{- end }}
    values:
      - "values-synaplan.yaml.gotmpl"
      {{- range .Values.customization.release.synaplan }}
      - {{ . }}
      {{- end }}

  - name: "stt"
    chart: "../../../charts/stt"
    installed: {{ .Values.apps.stt.enabled }}
    values:
      - "values-stt-{{ .Values.technical.stt.mode }}.yaml"
      - networkPolicy:
          enabled: true
          # Only the pods that read WHISPER_SERVER_URL: web (no component
          # label), worker and scheduler. Not the bundled redis or tts.
          from:
            - podSelector:
                matchLabels:
                  app.kubernetes.io/name: synaplan
                  app.kubernetes.io/instance: synaplan
                matchExpressions:
                  - key: app.kubernetes.io/component
                    operator: DoesNotExist
            - podSelector:
                matchLabels:
                  app.kubernetes.io/name: synaplan
                  app.kubernetes.io/instance: synaplan
                matchExpressions:
                  - key: app.kubernetes.io/component
                    operator: In
                    values: [worker, scheduler]
      {{- range .Values.customization.release.stt }}
      - {{ . }}
      {{- end }}
      # Synaplan's WHISPER_SERVER_URL relies on these two.
      - fullnameOverride: "stt"
        service:
          port: 8080
