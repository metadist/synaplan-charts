environments:
  {{ .Environment.Name }}: {}

---

repositories:
  - name: "synaplan-mariadb-repo"
    url: {{ .Values.charts.synaplanMariadb.repository | quote }}
    oci: true

releases:
  - name: "synaplan"
    chart: "../../../charts/synaplan"
    installed: {{ .Values.apps.synaplan.enabled }}
    {{- if .Values.apps.synaplanStt.enabled }}
    needs:
      - "synaplan-stt"
    {{- end }}
    values:
      - "values-synaplan.yaml.gotmpl"
      {{- range .Values.customization.release.synaplan }}
      - {{ . }}
      {{- end }}

  # Nextcloud app. Needs a Nextcloud in the namespace (openDesk's), which
  # this Helmfile does not install; the Job waits for it.
  - name: "synaplan-nextcloud"
    chart: "../../../charts/synaplan-nextcloud"
    installed: {{ dig "apps" "synaplanNextcloud" "enabled" false .Values }}
    needs:
      - "synaplan"
    values:
      - "values-synaplan-nextcloud.yaml.gotmpl"
      {{- range .Values.customization.release.synaplanNextcloud }}
      - {{ . }}
      {{- end }}

  # Portal tile. Needs openDesk's portal, which this Helmfile does not
  # install; the Job waits for it.
  - name: "synaplan-opendesk"
    chart: "../../../charts/synaplan-opendesk"
    installed: {{ dig "apps" "synaplanOpendesk" "enabled" false .Values }}
    needs:
      - "synaplan"
    values:
      - "values-synaplan-opendesk.yaml.gotmpl"
      {{- range .Values.customization.release.synaplanOpendesk }}
      - {{ . }}
      {{- end }}

  # OpenCloud plugin: the token-exchange service and the web extension, for
  # an OpenCloud next to Synaplan. OpenCloud's proxy route and web-extension
  # mount are set on the OpenCloud release, not here.
  - name: "synaplan-opencloud"
    chart: "../../../charts/synaplan-opencloud"
    installed: {{ dig "apps" "synaplanOpencloud" "enabled" false .Values }}
    needs:
      - "synaplan"
    values:
      - "values-synaplan-opencloud.yaml.gotmpl"
      {{- range .Values.customization.release.synaplanOpencloud }}
      - {{ . }}
      {{- end }}

  - name: "synaplan-stt"
    chart: "../../../charts/stt"
    installed: {{ .Values.apps.synaplanStt.enabled }}
    values:
      - "values-stt.yaml.gotmpl"
      - "values-stt-{{ .Values.technical.synaplanStt.mode }}.yaml"
      {{- range .Values.customization.release.synaplanStt }}
      - {{ . }}
      {{- end }}

  # Reads its root and user password from synaplan-credentials, which the
  # synaplan release creates.
  - name: "synaplan-mariadb"
    chart: "synaplan-mariadb-repo/{{ .Values.charts.synaplanMariadb.name }}"
    version: {{ .Values.charts.synaplanMariadb.version | quote }}
    installed: {{ .Values.apps.synaplanMariadb.enabled }}
    needs:
      - "synaplan"
    values:
      - "values-synaplan-mariadb.yaml.gotmpl"
      {{- range .Values.customization.release.synaplanMariadb }}
      - {{ . }}
      {{- end }}
