# Meeting notes (synaScriber) in openDesk's Jitsi: values for the jitsi
# release. Reference this file from your openDesk environment:
#
#   customization:
#     release:
#       jitsi:
#         synascriber: "<path to this file>"
#
# head.html loads the plugin's loader script from Synaplan (the button's
# sign-in returns to a page of the plugin on Synaplan, nothing else is served
# here); an init container copies the Prosody module from the transcriber
# image, which carries it; Jicofo streams each speaker's audio to the
# transcriber. The shared secrets are derived from MASTER_PASSWORD exactly
# as the synaplan release derives them (environments/default/secrets.yaml.gotmpl),
# so Jitsi needs nothing from that release at start.
#
# Environment: MASTER_PASSWORD, DOMAIN (openDesk's global.domain),
# SYNAPLAN_TRANSCRIBER_IMAGE (default below, keep in step with
# images.synaplanTranscriber), SYNAPLAN_HOST, KEYCLOAK_HOST, KEYCLOAK_REALM,
# SYNAPLAN_RELEASE.
{{- $masterPassword := requiredEnv "MASTER_PASSWORD" }}
{{- $domain := env "DOMAIN" | default "opendesk.internal" }}
{{- $image := env "SYNAPLAN_TRANSCRIBER_IMAGE" | default "ghcr.io/metadist/synaplan-transcriber:edea8b7" }}
{{- $synaplan := printf "https://%s.%s" (env "SYNAPLAN_HOST" | default "synaplan") $domain }}
{{- $issuer := printf "https://%s.%s/realms/%s" (env "KEYCLOAK_HOST" | default "id") $domain (env "KEYCLOAK_REALM" | default "opendesk") }}
{{- $release := env "SYNAPLAN_RELEASE" | default "synaplan" }}
{{- $copy := dict "image" $image "imagePullPolicy" "IfNotPresent" "securityContext" (dict "allowPrivilegeEscalation" false "readOnlyRootFilesystem" true "capabilities" (dict "drop" (list "ALL"))) }}
jitsi:
  web:
    extraFiles:
      - path: /usr/share/jitsi-meet/head.html
        content: |
          <script defer src="{{ $synaplan }}/api/v1/plugins/synascriber/assets/jitsi/loader.js" data-synaplan="{{ $synaplan }}" data-issuer="{{ $issuer }}" data-client-id="synascriber"></script>
  prosody:
    extraInitContainers:
      - {{ merge (dict "name" "synascriber-files" "command" (list "sh" "-c" "cp /app/prosody/mod_synascriber.lua /files/") "volumeMounts" (list (dict "name" "synascriber-files" "mountPath" "/files"))) $copy | toJson }}
    extraVolumes:
      - name: synascriber-files
        emptyDir: {}
    extraVolumeMounts:
      - name: synascriber-files
        mountPath: /prosody-plugins-custom/mod_synascriber.lua
        subPath: mod_synascriber.lua
        readOnly: true
    extraEnvs:
      XMPP_MODULES: "synascriber"
      SYNASCRIBER_SECRET: {{ derivePassword 1 "long" $masterPassword "synascriber" "prosody_secret" | sha1sum | quote }}
  jicofo:
    extraEnvs:
      SYNASCRIBER_TRANSCRIBER_TOKEN: {{ derivePassword 1 "long" $masterPassword "synascriber" "transcriber_token" | sha1sum | quote }}
    custom:
      configs:
        _custom_jicofo_conf: |
          jicofo {
            transcription {
              url-template = "ws://{{ $release }}-synascriber-transcriber:8095/transcribe?sessionId={{ "{{" }}MEETING_ID{{ "}}" }}"
              http-headers {
                "Authorization" = "Bearer "${?SYNASCRIBER_TRANSCRIBER_TOKEN}
              }
            }
          }
