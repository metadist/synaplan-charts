apps:
  synaplan:
    enabled: true
  # Nextcloud app (charts/synaplan-nextcloud). Off until a Nextcloud is in the namespace.
  synaplanNextcloud:
    enabled: false
  # openDesk portal tile (charts/synaplan-opendesk). Off until the release runs inside openDesk.
  synaplanOpendesk:
    enabled: false
  # OpenCloud plugin (charts/synaplan-opencloud). Off until an OpenCloud is wired to it.
  synaplanOpencloud:
    enabled: false
  # Speech-to-text server (charts/stt); off: Synaplan runs whisper.cpp in its pod
  synaplanStt:
    enabled: false
  # MariaDB 11.8 for Synaplan, with the chart of openDesk's MariaDB
  synaplanMariadb:
    enabled: true
  tika:
    enabled: true
  triton:
    enabled: false
  ollama:
    enabled: false
