{{- $masterPassword := env "MASTER_PASSWORD" }}
# Derived from MASTER_PASSWORD when it is set, and then written on every
# apply. Without it, the values already in the cluster stay.
secrets:
  synaplan:
    appSecret:
      value: {{ if $masterPassword }}{{ derivePassword 1 "long" $masterPassword "synaplan" "appSecret" | sha1sum | quote }}{{ else }}""{{ end }}
    adminPassword:
      value: {{ if $masterPassword }}{{ derivePassword 1 "long" $masterPassword "synaplan" "adminPassword" | sha1sum | quote }}{{ else }}""{{ end }}
  synaplanMariadb:
    rootPassword:
      value: {{ if $masterPassword }}{{ derivePassword 1 "long" $masterPassword "synaplan_mariadb" "root_password" | sha1sum | quote }}{{ else }}""{{ end }}
  keycloak:
    clientSecret:
      synaplan:
        value: {{ if $masterPassword }}{{ derivePassword 1 "long" $masterPassword "keycloak" "synaplan_client_secret" | sha1sum | quote }}{{ else }}""{{ end }}
  # Meeting notes: shared with Jitsi's Prosody and Jicofo through the Secrets
  # synaplan-synascriber-prosody and synaplan-synascriber-jicofo
  synascriber:
    prosodySecret:
      value: {{ if $masterPassword }}{{ derivePassword 1 "long" $masterPassword "synascriber" "prosody_secret" | sha1sum | quote }}{{ else }}""{{ end }}
    transcriberToken:
      value: {{ if $masterPassword }}{{ derivePassword 1 "long" $masterPassword "synascriber" "transcriber_token" | sha1sum | quote }}{{ else }}""{{ end }}
    apiKey:
      value: {{ if $masterPassword }}{{ printf "sk_%s" (derivePassword 1 "long" $masterPassword "synascriber" "api_key" | sha1sum) | quote }}{{ else }}""{{ end }}
