# Empty repository and tag keep the image of the chart.
images:
  synaplan:
    registry: ""
    repository: ""
    tag: ""
  # Synaplan needs MariaDB 11.7 or newer (VECTOR type)
  synaplanMariadb:
    registry: "docker.io"
    repository: "library/mariadb"
    tag: "13.0"
  tika:
    registry: ""
    repository: ""
    tag: ""
  # Meeting notes (technical.synaplan.synascriber): the transcriber, which
  # also carries mod_synascriber.lua for Jitsi's Prosody. Released together
  # with Synaplan under the same version; empty tag = the chart's appVersion.
  # Pinned to the first published commit until a Synaplan release carries
  # the plugin.
  synaplanTranscriber:
    registry: "ghcr.io"
    repository: "metadist/synaplan-transcriber"
    tag: "92804be"
  ollama:
    registry: ""
    repository: ""
    tag: ""
