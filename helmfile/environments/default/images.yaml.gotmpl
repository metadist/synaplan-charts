# Empty repository and tag keep the image of the chart.
images:
  synaplan:
    registry: ""
    repository: ""
    tag: ""
  # Synaplan needs MariaDB 11.7 or newer (VECTOR type)
  synaplanMariadb:
    registry: "docker.io"
    repository: "library/mariadb"
    tag: "13.0"
  tika:
    registry: ""
    repository: ""
    tag: ""
  # Meeting notes (technical.synaplan.synascriber): the transcriber, which
  # also carries mod_synascriber.lua for Jitsi's Prosody. Released together
  # with Synaplan. Empty tag uses the synaplan chart appVersion.
  # helmfile/opendesk/synascriber-jitsi.yaml.gotmpl defaults
  # SYNAPLAN_TRANSCRIBER_IMAGE to the same version. Keep that default in step
  # when the appVersion changes. Jitsi copies the Prosody module out of this image.
  synaplanTranscriber:
    registry: "ghcr.io"
    repository: "metadist/synaplan-transcriber"
    tag: ""
  ollama:
    registry: ""
    repository: ""
    tag: ""
