# Empty repository and tag keep the image of the chart.
images:
  synaplan:
    registry: ""
    repository: ""
    tag: ""
  # Synaplan needs MariaDB 11.7 or newer (VECTOR type)
  synaplanMariadb:
    registry: "docker.io"
    repository: "library/mariadb"
    tag: "13.0"
  tika:
    registry: ""
    repository: ""
    tag: ""
  # Meeting notes (technical.synaplan.synascriber): the transcriber, which
  # also carries mod_synascriber.lua for Jitsi's Prosody. Empty tag uses the
  # synaplan chart appVersion. Jitsi's values file defaults
  # SYNAPLAN_TRANSCRIBER_IMAGE on its own; that image is what Jitsi copies
  # the Prosody module from, and it can move ahead of this tag.
  synaplanTranscriber:
    registry: "ghcr.io"
    repository: "metadist/synaplan-transcriber"
    tag: ""
  ollama:
    registry: ""
    repository: ""
    tag: ""
