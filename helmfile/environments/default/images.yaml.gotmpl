# Empty repository and tag keep the image of the chart.
images:
  synaplan:
    registry: ""
    repository: ""
    tag: ""
  # Synaplan needs MariaDB 11.7 or newer (VECTOR type)
  synaplanMariadb:
    registry: "docker.io"
    repository: "library/mariadb"
    tag: "13.0"
  tika:
    registry: ""
    repository: ""
    tag: ""
  # Meeting notes (technical.synaplan.synascriber): the transcriber, which
  # also carries mod_synascriber.lua for Jitsi's Prosody. Pin a published
  # tag (metadist/synaplan publishes the version and the short commit).
  synaplanTranscriber:
    registry: "ghcr.io"
    repository: "metadist/synaplan-transcriber"
    tag: "92804be"
  ollama:
    registry: ""
    repository: ""
    tag: ""
