# Empty repository and tag keep the image of the chart.
images:
  synaplan:
    registry: ""
    repository: ""
    tag: ""
  # Synaplan needs MariaDB 11.7 or newer (VECTOR type)
  synaplanMariadb:
    registry: "docker.io"
    repository: "library/mariadb"
    tag: "13.0"
  tika:
    registry: ""
    repository: ""
    tag: ""
  # Meeting notes (technical.synaplan.synascriber): the synaScriber files
  # image (plugin, Jitsi's silent page, Prosody module) and the transcriber
  synascriber:
    registry: "ghcr.io"
    repository: "metadist/synascriber"
    tag: "0.3.0"
  synaplanTranscriber:
    registry: "ghcr.io"
    repository: "metadist/synaplan-transcriber"
    tag: "09d72d3"
  ollama:
    registry: ""
    repository: ""
    tag: ""
