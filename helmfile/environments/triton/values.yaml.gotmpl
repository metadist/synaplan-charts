# Example environment: models run on a Triton that this deployment installs.

apps:
  triton:
    enabled: true

technical:
  # "gpu" needs an NVIDIA GPU; "cpu" runs without one, slowly.
  triton:
    mode: "gpu"
  synaplan:
    models:
      enabled:
        - "triton:gpt-oss-20b"
        - "triton:bge-m3"
        - "triton:mistral-7b-instruct-v0.3"
      defaults:
        chat: "triton:gpt-oss-20b"
        sort: "triton:gpt-oss-20b"
        vectorize: "triton:bge-m3"
